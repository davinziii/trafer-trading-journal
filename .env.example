# Copy this file to .env.local and fill in your key to enable the AI Trade Summary.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which Gemini models to use. When one is busy (503 "high demand") or rate-limited (429),
# the app retries it once, then moves to the next model. Defaults are in lib/gemini.ts.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
